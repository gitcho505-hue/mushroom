{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/catalog-sitemap"
    },
    {
      "source": "/image-sitemap.xml",
      "destination": "/api/image-sitemap"
    },
    {
      "source": "/bg",
      "destination": "/api/site-page?locale=bg"
    },
    {
      "source": "/bg/",
      "destination": "/api/site-page?locale=bg"
    },
    {
      "source": "/bg/:path*",
      "destination": "/api/site-page?locale=bg&path=:path*"
    },
    {
      "source": "/en",
      "destination": "/api/site-page?locale=en"
    },
    {
      "source": "/en/",
      "destination": "/api/site-page?locale=en"
    },
    {
      "source": "/en/:path*",
      "destination": "/api/site-page?locale=en&path=:path*"
    },
    {
      "source": "/it",
      "destination": "/api/site-page?locale=it"
    },
    {
      "source": "/it/",
      "destination": "/api/site-page?locale=it"
    },
    {
      "source": "/it/:path*",
      "destination": "/api/site-page?locale=it&path=:path*"
    },
    {
      "source": "/fr",
      "destination": "/api/site-page?locale=fr"
    },
    {
      "source": "/fr/",
      "destination": "/api/site-page?locale=fr"
    },
    {
      "source": "/fr/:path*",
      "destination": "/api/site-page?locale=fr&path=:path*"
    },
    {
      "source": "/de",
      "destination": "/api/site-page?locale=de"
    },
    {
      "source": "/de/",
      "destination": "/api/site-page?locale=de"
    },
    {
      "source": "/de/:path*",
      "destination": "/api/site-page?locale=de&path=:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin/"
    }
  ],
  "redirects": [
    {
      "source": "/bg/produkti/black-truffle",
      "destination": "/bg/produkti/cheren-tryufel",
      "permanent": true
    },
    {
      "source": "/bg/tryufeli/black-truffle",
      "destination": "/bg/tryufeli/cheren-tryufel",
      "permanent": true
    },
    {
      "source": "/bg/produkti/white-truffle",
      "destination": "/bg/produkti/byal-tryufel",
      "permanent": true
    },
    {
      "source": "/bg/tryufeli/white-truffle",
      "destination": "/bg/tryufeli/byal-tryufel",
      "permanent": true
    },
    {
      "source": "/bg/produkti/summer-truffle",
      "destination": "/bg/produkti/leten-tryufel",
      "permanent": true
    },
    {
      "source": "/bg/tryufeli/summer-truffle",
      "destination": "/bg/tryufeli/leten-tryufel",
      "permanent": true
    },
    {
      "source": "/bg/produkti/burgundy-truffle",
      "destination": "/bg/produkti/burgundski-tryufel",
      "permanent": true
    },
    {
      "source": "/bg/tryufeli/burgundy-truffle",
      "destination": "/bg/tryufeli/burgundski-tryufel",
      "permanent": true
    }
  ],
  "functions": {
    "api/gallery-page.js": {
      "includeFiles": "{dist/server/**,dist/client/gallery-shell.html,.env.production}",
      "maxDuration": 30
    },
    "api/image-sitemap.js": {
      "includeFiles": ".env.production",
      "maxDuration": 30
    },
    "api/site-page.js": {
      "includeFiles": "{dist/server/**,dist/client/gallery-shell.html,.env.production}",
      "maxDuration": 30
    },
    "api/catalog-sitemap.js": {
      "includeFiles": "{dist/server/**,dist/client/gallery-shell.html,.env.production}",
      "maxDuration": 30
    }
  }
}
