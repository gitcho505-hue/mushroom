{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/image-sitemap.xml",
      "destination": "/api/image-sitemap"
    },
    {
      "source": "/bg",
      "destination": "/api/gallery-page?locale=bg&kind=home"
    },
    {
      "source": "/bg/",
      "destination": "/api/gallery-page?locale=bg&kind=home"
    },
    {
      "source": "/bg/galeriya",
      "destination": "/api/gallery-page?locale=bg&kind=gallery"
    },
    {
      "source": "/bg/galeriya/",
      "destination": "/api/gallery-page?locale=bg&kind=gallery"
    },
    {
      "source": "/en",
      "destination": "/api/gallery-page?locale=en&kind=home"
    },
    {
      "source": "/en/",
      "destination": "/api/gallery-page?locale=en&kind=home"
    },
    {
      "source": "/en/gallery",
      "destination": "/api/gallery-page?locale=en&kind=gallery"
    },
    {
      "source": "/en/gallery/",
      "destination": "/api/gallery-page?locale=en&kind=gallery"
    },
    {
      "source": "/it",
      "destination": "/api/gallery-page?locale=it&kind=home"
    },
    {
      "source": "/it/",
      "destination": "/api/gallery-page?locale=it&kind=home"
    },
    {
      "source": "/it/galleria",
      "destination": "/api/gallery-page?locale=it&kind=gallery"
    },
    {
      "source": "/it/galleria/",
      "destination": "/api/gallery-page?locale=it&kind=gallery"
    },
    {
      "source": "/fr",
      "destination": "/api/gallery-page?locale=fr&kind=home"
    },
    {
      "source": "/fr/",
      "destination": "/api/gallery-page?locale=fr&kind=home"
    },
    {
      "source": "/fr/galerie",
      "destination": "/api/gallery-page?locale=fr&kind=gallery"
    },
    {
      "source": "/fr/galerie/",
      "destination": "/api/gallery-page?locale=fr&kind=gallery"
    },
    {
      "source": "/de",
      "destination": "/api/gallery-page?locale=de&kind=home"
    },
    {
      "source": "/de/",
      "destination": "/api/gallery-page?locale=de&kind=home"
    },
    {
      "source": "/de/galerie",
      "destination": "/api/gallery-page?locale=de&kind=gallery"
    },
    {
      "source": "/de/galerie/",
      "destination": "/api/gallery-page?locale=de&kind=gallery"
    },
    {
      "source": "/admin",
      "destination": "/admin/"
    },
    {
      "source": "/bg/produkti/:slug",
      "destination": "/spa.html"
    },
    {
      "source": "/en/products/:slug",
      "destination": "/spa.html"
    },
    {
      "source": "/it/prodotti/:slug",
      "destination": "/spa.html"
    },
    {
      "source": "/fr/produits/:slug",
      "destination": "/spa.html"
    },
    {
      "source": "/de/produkte/:slug",
      "destination": "/spa.html"
    },
    {
      "source": "/bg/produkti/item/:id",
      "destination": "/spa.html"
    },
    {
      "source": "/en/products/item/:id",
      "destination": "/spa.html"
    },
    {
      "source": "/it/prodotti/item/:id",
      "destination": "/spa.html"
    },
    {
      "source": "/fr/produits/item/:id",
      "destination": "/spa.html"
    },
    {
      "source": "/de/produkte/item/:id",
      "destination": "/spa.html"
    }
  ],
  "redirects": [
    {
      "source": "/bg/produkti/black-truffle",
      "destination": "/bg/produkti/cheren-tryufel",
      "permanent": true
    },
    {
      "source": "/bg/tryufeli/black-truffle",
      "destination": "/bg/tryufeli/cheren-tryufel",
      "permanent": true
    },
    {
      "source": "/bg/produkti/white-truffle",
      "destination": "/bg/produkti/byal-tryufel",
      "permanent": true
    },
    {
      "source": "/bg/tryufeli/white-truffle",
      "destination": "/bg/tryufeli/byal-tryufel",
      "permanent": true
    },
    {
      "source": "/bg/produkti/summer-truffle",
      "destination": "/bg/produkti/leten-tryufel",
      "permanent": true
    },
    {
      "source": "/bg/tryufeli/summer-truffle",
      "destination": "/bg/tryufeli/leten-tryufel",
      "permanent": true
    },
    {
      "source": "/bg/produkti/burgundy-truffle",
      "destination": "/bg/produkti/burgundski-tryufel",
      "permanent": true
    },
    {
      "source": "/bg/tryufeli/burgundy-truffle",
      "destination": "/bg/tryufeli/burgundski-tryufel",
      "permanent": true
    }
  ],
  "functions": {
    "api/gallery-page.js": {
      "includeFiles": "{dist/server/**,dist/client/gallery-shell.html,.env.production}",
      "maxDuration": 30
    },
    "api/image-sitemap.js": {
      "includeFiles": ".env.production",
      "maxDuration": 30
    }
  }
}
